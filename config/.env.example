# Copiar a config/.env y completar según el sitio que requiera login.
# config/.env está en .gitignore: nunca se versiona.

# SITIO_A_USER=
# SITIO_A_PASS=

# Modo standalone (npm run web) — habla con Claude vía el CLI de Claude Code
# (tu sesión ya logueada), no requiere ninguna API key acá.
# WEB_PORT=4127

# Solo para desarrollo/testing: apuntar a un binario de "claude" que no está
# en el PATH (ej. el bundleado por la extensión de VSCode).
# CLAUDE_CLI_PATH=
